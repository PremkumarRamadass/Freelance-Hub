# FreelanceHub Backend Environment Configuration
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=freelancehub_db
DB_SSL=false

# Full Connection URL (Takes priority if provided, e.g. for Supabase / Neon / Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelancehub_db

# Security
JWT_SECRET=fh_enterprise_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d
